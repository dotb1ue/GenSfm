{
    "models": {
        "encoder": {
            "name": "SparseStructureEncoder",
            "args": {
                "in_channels": 3,
                "latent_channels": 8,
                "num_res_blocks": 2,
                "num_res_blocks_middle": 2,
                "channels": [32, 64, 128, 256, 512],
                "use_fp16": true
            },
            "compile": true
        },
        "decoder": {
            "name": "SparseStructureDecoder",
            "args": {
                "out_channels": 3,
                "latent_channels": 8,
                "num_res_blocks": 2,
                "num_res_blocks_middle": 2,
                "channels": [512, 256, 128, 64, 32],
                "use_fp16": true
            },
            "compile": true
        }
    },
    "dataset": {
        "name": "ImageConditionedSparseUVStructure",
        "args": {
            "resolution": 64,
            "min_aesthetic_score": 4.5,
            "crop_size_ratio": 1.2
        }
    },
    "trainer": {
        "name": "SparseUVStructureVaeTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 4,
            "batch_split": 1,
            "num_workers": 8,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 3e-4,
                    "weight_decay": 1e-3,
                    "eps": 1e-3
                }
            },
            "lr_scheduler": {
                "name": "CosineWarmupScheduler",
                "args": {
                    "warmup_steps": 1000,
                    "max_steps": 1000000,
                    "end_lr": 1e-5
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "classification_loss_type": "dice",
            "regression_loss_type": "l1",
            "uv_loss_mask": "full",
            "lambda_kl": 0.001,
            "lambda_uv_volume": 1.0
        }
    },
    "evaluator": {
        "name": "SparseUVStructureVaeEvaluator",
        "args": {
            "load_ema": 0.9999,
            "batch_size_per_gpu": 8,
            "use_ss_as_weights": true,
            "dilation_sigma": 0.5,
            "dilation_min_weight": 0.05
        }
    }
}