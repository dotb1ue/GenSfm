{
    "models": {
        "denoiser": {
            "name": "VisualMultiPoseSparseStructureFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 8,
                "out_channels": 8,
                "pose_resolution": 4,
                "pose_in_channels": 8,
                "pose_out_channels": 8,
                "model_channels": 1024,
                "cond_channels": 1536,
                "dino_cond_channels": 1024,
                "visual_input_channels": 3,
                "visual_feat_resolution": 296,
                "visual_patch_resolution": 37,
                "visual_feat_channels": [6, 6, 6, 8],
                "visual_conv_kernel_size": 5,
                "num_blocks": 24,
                "num_heads": 16,
                "mlp_ratio": 4,
                "patch_size": 1,
                "pose_patch_size": 1,
                "pe_mode": "ape",
                "fusion_layer_type": null,
                "self_attn_layout": "joint",
                "cross_attn_layout": "full",
                "num_view_embeds": 4,
                "num_shared_register_tokens": 128,
                "qk_rms_norm": true,
                "use_fp16": true
            },
            "compile": true
        }
    },
    "dataset": {
        "name": "MultiViewImageConditionedSparseUVStructureLatent",
        "args": {
            "ss_latent_model": "ss_enc_conv3d_16l8_fp16",
            "suv_latent_model": "uv_vae_4_ema0.9999_step1000000",
            "min_aesthetic_score": 4.5,
            "image_size": 518,
            "pretrained_ss_dec": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16",
            "pretrained_suv_dec": "dotblue/GenSfm/ckpts/uv_decoder",
            "suv_latent_channels": 8,
            "crop_size_ratio": 1.2,
            "seperate_pose_latent": true,
            "num_pose_views": 4,
            "view_selection": "random"
        }
    },
    "trainer": {
        "name": "VisualImageConditionedMultiPoseFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 8,
            "batch_split": 2,
            "num_workers": 8,
            "finetune_ckpt": {
                "denoiser": {
                    "path": "checkpoint/TRELLIS-image-large/ckpts/ss_flow_img_dit_L_16l8_fp16.safetensors",
                    "mismatch_strategy": "zeropad"
                }
            },
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.0,
                    "weight_decay_bias": 0.0,
                    "weight_decay_layer_norm": 0.0,
                    "eps": 5e-6
                }
            },
            "lr_scheduler": {
                "name": "CosineWarmupScheduler",
                "args": {
                    "warmup_steps": 1000,
                    "max_steps": 1000000,
                    "end_lr": 1e-5
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "t_coupling": {
                "shared": 0.8,
                "per_pose": 0.2
            },
            "sigma_min": 1e-5,
            "image_cond_model": "dinov2_vitl14_reg",
            "image_cond_model_compile": true
        }
    },
    "eval_dataset": {
        "name": "MultiViewImageConditionedSparseUVStructureWithLatent",
        "args": {
            "ss_latent_model": "ss_enc_conv3d_16l8_fp16",
            "suv_latent_model": "uv_vae_4_ema0.9999_step1000000",
            "min_aesthetic_score": 4.5,
            "image_size": 518,
            "pretrained_ss_dec": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16",
            "pretrained_suv_dec": "dotblue/GenSfm/ckpts/uv_decoder",
            "suv_latent_channels": 8,
            "crop_size_ratio": 1.2,
            "seperate_pose_latent": true,
            "eval_view_sub_sample": 12,
            "eval_view_sub_sample_offset": 6,
            "return_depth_map": true,
            "return_raw_cond": true,
            "num_pose_views": 4
        }
    },
    "eval_models": {
        "slat_decoder_gs": "microsoft/TRELLIS-image-large/ckpts/slat_dec_gs_swin8_B_64l8gs32_fp16",
        "slat_decoder_rf": "microsoft/TRELLIS-image-large/ckpts/slat_dec_rf_swin8_B_64l8r16_fp16",
        "slat_decoder_mesh": "microsoft/TRELLIS-image-large/ckpts/slat_dec_mesh_swin8_B_64l8m256c_fp16",
        "ss_decoder": {
            "path": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16",
            "compile": true
        },
        "suv_decoder": {
            "path": "dotblue/GenSfm/ckpts/uv_decoder",
            "compile": true
        },
        "slat_denoiser": {
            "path": "dotblue/GenSfm/ckpts/stage2_slat",
            "compile": true
        }
    },
    "evaluator": {
        "name": "VisualImageConditionedMultiPoseSparseFlowMatchingEvaluator",
        "args": {
            "load_ema": 0.9999,
            "batch_size_per_gpu": 4,
            "num_workers": 4,
            "render_resolution": 518,
            "ssuv_uses_visual": true,
            "normalization": {
                "mean": [
                    -2.1687545776367188,
                    -0.004347046371549368,
                    -0.13352349400520325,
                    -0.08418072760105133,
                    -0.5271206498146057,
                    0.7238689064979553,
                    -1.1414450407028198,
                    1.2039363384246826
                ],
                "std": [
                    2.377650737762451,
                    2.386378288269043,
                    2.124418020248413,
                    2.1748552322387695,
                    2.663944721221924,
                    2.371192216873169,
                    2.6217446327209473,
                    2.684523105621338
                ]
            },
            "sample_ssuv": true,
            "slat_sampler_args": {
                "name": "FlowEulerGuidanceIntervalSampler",
                "args": {
                    "sigma_min": 1e-05
                },
                "params": {
                    "steps": 25,
                    "cfg_strength": 3.0,
                    "cfg_interval": [0.5, 1.0],
                    "rescale_t": 3.0
                }
            },
            "ssuv_sampler_args": {
                "name": "MultiPoseFlowEulerGuidanceIntervalSampler",
                "args": {
                    "sigma_min": 1e-05
                },
                "params": {
                    "steps": 25,
                    "cfg_strength": 7.5,
                    "cfg_interval": [0.5, 1.0],
                    "rescale_t": 3.0
                }
            },
            "predict_ssuv_from_ss": true,
            "dilation_sigma": 0.5,
            "dilation_min_weight": 0.05,
            "evaluate_novel_view": false,
            "evaluate_cross_view": false,
            "evaluate_clip_metric": false,
            "save_results": false,
            "save_nv_as_grid": true,
            "save_mesh": false,
            "max_num_samples": 800,
            "render_bg_color": [0.0, 0.0, 0.0]
        }
    }
}
